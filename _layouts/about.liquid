---
layout: default
---

<div class="post">
  <header class="post-header">
    <div class="d-flex align-items-center mb-4">
      {% if page.profile.image %}
        <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}" style="margin-{% if page.profile.align == 'left' %}right{% else %}left{% endif %}: 20px;">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          <img src="{{ profile_image_path }}" alt="Profile image" class="img-fluid profile-img" style="height: 200px; object-fit: cover; border-radius: 10px;">
        </div>
      {% endif %}

      <!-- Name and Info -->
      <div class="col-sm-9 pl-3" style="text-align: left;">
        <h1 class="post-title">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>

        <p class="desc">
          {{ site.current_status }}<br>
          {{ site.lab_info }}<br>
          {{ site.affiliation }}<br>
          {{ site.email_contact }}
        </p>

        <!-- Social icons below personal info -->
        <div class="contact-icons mt-2">
          {% if site.scholar_userid %}
            <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" title="Google Scholar">
              <i class="ai ai-google-scholar ai-lg mr-2"></i>
            </a>
          {% endif %}

          {% if site.github_username %}
            <a href="https://github.com/{{ site.github_username }}" title="GitHub">
              <i class="fab fa-github fa-lg mr-2"></i>
            </a>
          {% endif %}

          {% if site.linkedin_username %}
            <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}" title="LinkedIn">
              <i class="fab fa-linkedin fa-lg mr-2"></i>
            </a>
          {% endif %}

          {% if site.orcid_id %}
            <a href="https://orcid.org/{{ site.orcid_id }}" title="ORCID">
              <i class="ai ai-orcid ai-lg mr-2"></i>
            </a>
          {% endif %}

      </div>
    </div>
  </header>

  <article>
    <div class="clearfix">{{ content }}</div>

    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">🔥 News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">📝 Latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">📃 Selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if page.social %}
      <div class="social">
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
